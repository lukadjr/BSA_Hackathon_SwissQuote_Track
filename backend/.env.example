# backend/.env is loaded automatically; shell environment values take precedence.
DATABASE_URL=sqlite:///./swissquote_mock.db
MOCK_USER_ID=demo-user
MOCK_DISPLAY_NAME=Swissquote demo client
# verified / pending / rejected. Missing setting defaults to pending.
MOCK_KYC_STATUS=verified
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WALLET_LINK_DOMAIN=swissquote-wallet.demo
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Server-provisioned demo credential; never use EXPO_PUBLIC_* or commit its value.
MOCK_ACCESS_TOKEN=
# Planned integrations (not read yet):
BUNDLER_RPC_URL=
PAYMASTER_SERVICE_URL=
PAYMASTER_API_KEY=
SWISSQUOTE_GUARDIAN_SIGNER_REF=
# No client EOA private keys, including in local configuration.

# Run app.funding.setup once to generate a persistent TESTNET treasury in local .env.
# The API loads public settings; only the separate treasury worker loads this key.
SWISSQUOTE_TREASURY_PRIVATE_KEY=
SWISSQUOTE_TREASURY_ADDRESS=
ERC20_TEST_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Use absolute paths when API and worker start from different working directories.
TREASURY_JOURNAL_PATH=
# Default false: enforce Candide After7Days, three guardians and threshold 2.
# true permits disposable funding tests before recovery is ready; UI/consent disclose it.
FUNDING_ALLOW_UNPROTECTED_DEMO=false
